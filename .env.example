## 站点地址（用于 canonical、OG 标签和绝对 URL 生成）
SITE_URL=https://yuwb.dev

## MySQL 连接串
DATABASE_URL=mysql://username:password@your-host:3306/your_database

## MySQL TLS（本机 127.0.0.1 保持 false；远程数据库设为 true）
DATABASE_SSL=false

## 认证 Session 签名密钥（至少 32 字节随机字符串）
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
